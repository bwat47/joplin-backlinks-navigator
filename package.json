{
    "name": "joplin-plugin-backlinks-navigator",
    "version": "1.5.2",
    "scripts": {
        "dist": "npm run typecheck && joplin-plugin-scripts build",
        "prepare": "npm run dist",
        "updateVersion": "joplin-plugin-scripts update-version",
        "updateApi": "joplin-plugin-scripts update-api",
        "lint": "eslint src/ test/",
        "lint:fix": "eslint src/ test/ --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run --passWithNoTests && node --test test/*.test.mjs",
        "test:watch": "vitest --passWithNoTests",
        "knip": "knip",
        "typecheck": "tsc --noEmit"
    },
    "license": "MIT",
    "engines": {
        "node": ">=22"
    },
    "keywords": [
        "joplin-plugin"
    ],
    "files": [
        "publish"
    ],
    "devDependencies": {
        "@bwat47/joplin-plugin-scripts": "^1.1.0",
        "@codemirror/state": "6.5.2",
        "@codemirror/view": "6.38.7",
        "@eslint/js": "^10.0.1",
        "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
        "@types/node": "^25.9.4",
        "@vitest/eslint-plugin": "^1.6.28",
        "esbuild": "^0.28.2",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import-x": "^4.17.1",
        "eslint-plugin-sonarjs": "^4.2.2",
        "eslint-plugin-tsdoc": "^0.5.4",
        "globals": "^17.6.0",
        "jsdom": "^30.1.3",
        "knip": "^6.42.1",
        "prettier": "^3.9.10",
        "typescript": "^6.0.3",
        "typescript-eslint": "8.72.1",
        "vitest": "^5.0.5"
    },
    "dependencies": {
        "@joplin/fork-uslug": "^2.0.6",
        "@lezer/common": "1.5.4",
        "@lezer/markdown": "1.8.1",
        "entities": "^9.0.0",
        "fuzzysort": "^4.0.2"
    },
    "overrides": {
        "eslint-plugin-tsdoc": {
            "@typescript-eslint/utils": "8.72.1"
        }
    }
}
